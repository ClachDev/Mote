# pixi environments
.pixi/*
!.pixi/config.toml

# colcon build artifacts
build/
install/
log/

#llm
.claude/
__pycache__/

scratchpad*

# Sim benchmark outputs (timestamped metrics/reports)
benchmark_results/
# Bag-replay scoring outputs (timestamped metrics/reports/maps)
bag_replay_results/
# Parameter-sweep outputs (timestamped rankings/reports/merged params)
sweep_results/

# Rendered cloud-init (`pixi run provision`): carries a Tailscale auth key and a
# wifi passphrase, so it must never be committed even by accident.
user-data

# The fleet box's own deployment config (mote_fleet/deploy/.env): host-specific,
# and it names the broker address robots dial. env.example is the committed one.
mote_fleet/deploy/.env
