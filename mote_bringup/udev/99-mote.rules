# Mote udev rules — install to /etc/udev/rules.d/99-mote.rules
# sudo cp 99-mote.rules /etc/udev/rules.d/
# sudo udevadm control --reload-rules && sudo udevadm trigger
#
# These match by USB vendor/product ID, which works as long as each device is
# the only one of its kind plugged in. If you run more than one device with the
# same VID:PID (e.g. two CP2102N adapters), add an ATTRS{serial}=="..." match to
# disambiguate. Find a device's serial with:
#   udevadm info -a -n /dev/ttyUSB0 | grep '{serial}'

# Waveshare Serial Bus Servo Driver (CH343)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", SYMLINK+="mote_servos", MODE="0666"

# SLAMTEC RPLIDAR C1 (Silicon Labs CP2102N)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="mote_lidar", MODE="0666"

# SO-101 follower arm servo bus. If the arm uses its own USB-serial adapter,
# fill in ATTRS{serial} from `pixi run arm-check` (it prints a ready-to-paste
# line) and uncomment. Pin by serial because the adapter likely shares the
# CH343 VID:PID of the wheel board (mote_servos) above — VID:PID alone can't
# tell the two apart. If the arm instead shares the wheel driver board, delete
# this rule and point robot.yaml `arm.port` at /dev/mote_servos.
# SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="REPLACE_ME", SYMLINK+="mote_arm", MODE="0666"

# UGREEN USB Camera — UVC cameras expose both a capture and a metadata video
# node; ID_V4L_CAPABILITIES pins the symlink to the capture node.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="2283", KERNEL=="video[0-9]*", ENV{ID_V4L_CAPABILITIES}=="*:capture:*", SYMLINK+="mote_camera"
