[Unit]
Description=Mote Hardware Bringup
# Order after the drive/lidar devices are enumerated by udev. The udev rules
# tag these devices TAG+="systemd", which makes systemd synthesise the
# dev-mote_*.device units referenced here. Wants (not Requires) gives ordering
# without hard-binding: a device that flaps mid-run must not force-kill the
# whole stack — the ExecStartPre self-check and the health_monitor handle
# presence and liveness instead.
After=network.target dev-mote_servos.device dev-mote_lidar.device
Wants=dev-mote_servos.device dev-mote_lidar.device
# Never permanently give up restarting: an unattended robot must self-heal when
# reconnected hardware reappears, so disable the start-rate cutoff and lean on
# RestartSec backoff (below) to avoid hammering the bus.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment=HOME=@HOME@
# Pre-flight gate: prove servos ping and the lidar/disk/clock are ready before
# opening the hardware. A non-zero exit fails the start; Restart re-runs this
# (with backoff) until it passes, so replugging the lidar recovers on its own.
ExecStartPre=@HOME@/.pixi/bin/pixi run self-check
# health:=false — mote-health.service runs the monitor here, independently, so it
# survives a bringup restart and can report one. Manual runs get it in-launch.
# foxglove:=false for the same reason: mote-foxglove.service keeps the operator's
# view up across a bringup restart, which is when they most need to look at it.
ExecStart=@HOME@/.pixi/bin/pixi run launch health:=false foxglove:=false
Restart=always
RestartSec=2
# Back off on repeated failures: 2s, stepping up to a 30s ceiling, instead of a
# fixed-interval hammer.
RestartSteps=5
RestartMaxDelaySec=30
# The self-check ExecStartPre runs under pixi and can take a few seconds.
TimeoutStartSec=120

# Loopback-only DDS transport (mote_bringup/config/cyclonedds.xml): the graph
# never touches a radio, so wifi cannot stall topic delivery on the board.
Environment=CYCLONEDDS_URI=file://@REPO@/mote_bringup/config/cyclonedds.xml
# Keep the ROS graph on the robot: from M2 the off-box view is foxglove_bridge
# (mote-foxglove.service), so nothing off-machine joins DDS and two robots on
# one LAN cannot see each other whatever their ROS_DOMAIN_ID. Transport is
# loopback-only anyway (cyclonedds.xml, above); the pin keeps discovery
# consistent with it. docs/fleet/README.md §4.
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

[Install]
WantedBy=multi-user.target
