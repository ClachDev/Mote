[Unit]
Description=Mote Data Recording
After=mote-bringup.service
# Wants + PartOf: recording follows bringup (restarts when it does) but is not
# required for it — a recorder crash must never take down the drive stack.
Wants=mote-bringup.service
PartOf=mote-bringup.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/Mote
Environment=HOME=@HOME@
ExecStart=@HOME@/.pixi/bin/pixi run record
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30

# Pin DDS to the robot's one real interface and drop non-discovery multicast
# (mote_bringup/config/cyclonedds.xml); @DDS_IFACE@ is filled in by install.sh.
Environment=CYCLONEDDS_URI=file://@HOME@/Mote/mote_bringup/config/cyclonedds.xml
Environment=MOTE_DDS_INTERFACE=@DDS_IFACE@

[Install]
WantedBy=multi-user.target
