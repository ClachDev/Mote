<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS configuration for the robot: the ROS graph rides loopback only,
  so wifi quality can never affect topic delivery between on-robot processes.
  A wlan0-pinned profile with an lo fallback is not equivalent — while the
  radio interface exists Cyclone advertises and prefers its locators even for
  same-host peers, so a wifi flap stalls scan delivery on the board itself
  (and ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST confines who is discovered,
  not which interface carries the packets).

  Remote observability is foxglove_bridge — a WebSocket server, not a DDS
  peer — so no off-board machine joins this graph. The one flow that needs a
  LAN peer (camera calibration) runs with the profile explicitly unset; see
  mote_perception/config/README.md.

  Loaded through CYCLONEDDS_URI, set for every pixi environment by
  [activation.env] in pixi.toml and repeated by the systemd units.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="true" presence_required="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
