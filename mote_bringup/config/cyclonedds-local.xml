<?xml version="1.0" encoding="UTF-8"?>
<!--
  Loopback-only CycloneDDS profile for on-robot mission sessions (mapping,
  exploration): the graph must not touch a radio at all.

  Why this exists (2026-07-29 flat-mapping runs): cyclonedds.xml lists lo as a
  fallback, but with wlan0 present every participant advertises and prefers
  wlan0 locators — including for same-host peers — so a wifi flap stalls scan
  delivery between processes that share the board (observed as 1-12 s scan
  gaps, and full graph wedges after long outages, with
  `ddsi_udp_conn_write ... failed` spam to the robot's own address). Setting
  ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST does not help: it confines *who* is
  discovered, not *which interface* carries the packets.

  With this profile the mission graph rides lo exclusively, so wifi quality is
  irrelevant to it. Remote observability is unaffected — foxglove_bridge is a
  WebSocket server, not a DDS peer. The cost is that no off-board DDS peer
  (RViz on a workstation) can see the session; that is already true of
  systemd-run robots via the LOCALHOST discovery pin, and Foxglove is the
  supported window.

  Use it for interactive mission runs:
    export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
    export CYCLONEDDS_URI=file://$PWD/mote_bringup/config/cyclonedds-local.xml
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="true" presence_required="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
