<?xml version="1.0" ?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mote_bringup</name>
  <version>0.0.0</version>
  <description>Launch files for the mote</description>
  <maintainer email="michael@clach.dev">Michael Johnson</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-yaml</exec_depend>
  <!-- The arm is part of the base now: MoteHardware drives it, and the base
       launch needs mote_arm.config to resolve this robot's calibration into
       the URDF. The dependency runs this way only — mote_arm must not import
       mote_bringup. -->
  <exec_depend>mote_arm</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- mote_launch.py starts the health monitor with the base. The dependency
       runs this way only: mote_health knows nothing about the launch files. -->
  <exec_depend>mote_health</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
