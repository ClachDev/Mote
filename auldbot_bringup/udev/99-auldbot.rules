# Auldbot udev rules — install to /etc/udev/rules.d/99-auldbot.rules
# sudo cp 99-auldbot.rules /etc/udev/rules.d/
# sudo udevadm control --reload-rules && sudo udevadm trigger

# Waveshare Serial Bus Servo Driver (CH343)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B14033830", SYMLINK+="auldbot_servos", MODE="0666"

# SLAMTEC RPLIDAR C1 (Silicon Labs CP2102N)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="66461e663f70f011b7868c301045c30f", SYMLINK+="auldbot_lidar", MODE="0666"

# UGREEN USB Camera (serial SN0001 is generic for this model — only one camera expected)
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="2283", ATTRS{serial}=="SN0001", KERNEL=="video[0-9]*", SYMLINK+="auldbot_camera"
