[Unit]
Description=AuldBot Navigation
After=auldbot-slam.service
Requires=auldbot-slam.service

[Service]
Type=simple
User=michael
WorkingDirectory=/home/michael/AuldBot
ExecStart=/home/michael/.pixi/bin/pixi run nav
Restart=on-failure
RestartSec=5
Environment=HOME=/home/michael

[Install]
WantedBy=multi-user.target
