# Copy to `.env` beside docker-compose.yml and edit. This file is the fleet
# box's entire configuration; everything else is in the compose file.

# The address ROBOTS should dial for the broker. Handed out verbatim in every
# enrollment answer, so it must be reachable from the robots — the fleet box's
# tailnet (MagicDNS) name, not localhost and not a container name. Required.
BROKER_HOST=fleet-box

# Which build to run. `latest` tracks main; pin a tag or a digest for a
# reproducible box. fleet-deploy.sh rewrites this line when it updates or rolls
# back, so this file always states what is actually deployed.
MOTE_FLEET_REF=ghcr.io/clachdev/mote-fleet:latest

# Published ports on the host. BROKER_WS_PORT is the one the *browser* connects
# to for the dashboard's live feed, so the server is told this number, not the
# container's 9001.
FLEET_PORT=8080
BROKER_PORT=1883
BROKER_WS_PORT=9001

# Confine those published ports to one interface — set to the fleet box's
# tailnet address with a trailing colon (e.g. "100.101.102.103:") so nothing is
# reachable from the LAN. Empty publishes on every interface.
BIND_PREFIX=
