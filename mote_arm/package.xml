<?xml version="1.0" ?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mote_arm</name>
  <version>0.0.0</version>
  <description>SO-101 follower arm: bench tools, pose teaching, and jog control on top of ros2_control</description>
  <maintainer email="michael@clach.dev">Michael Johnson</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>mote_description</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- The jog CLI, teleop and episode replay drive the arm through
       ros2_control: single-point trajectories to arm_controller, and
       switch_controller as the torque switch. None of them opens the servo bus. -->
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <!-- std_msgs: the teleop e-stop flag. -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- feetech-servo-sdk (imports as scservo_sdk) is a PyPI dep declared in
       pixi.toml; pyserial is its transport. -->
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
