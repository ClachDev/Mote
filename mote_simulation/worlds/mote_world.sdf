<?xml version="1.0"?>
<!-- Simple indoor room for simulating Mote: a 6x6 m walled room with a few
     box obstacles so the lidar always has structure to see and SLAM has
     features to match against. -->
<sdf version="1.8">
  <world name="mote_world">
    <physics name="default_physics" type="dartsim">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north">
          <pose>0 3 0.25 0 0 0</pose>
          <geometry><box><size>6.2 0.2 0.5</size></box></geometry>
        </collision>
        <visual name="north_v">
          <pose>0 3 0.25 0 0 0</pose>
          <geometry><box><size>6.2 0.2 0.5</size></box></geometry>
        </visual>
        <collision name="south">
          <pose>0 -3 0.25 0 0 0</pose>
          <geometry><box><size>6.2 0.2 0.5</size></box></geometry>
        </collision>
        <visual name="south_v">
          <pose>0 -3 0.25 0 0 0</pose>
          <geometry><box><size>6.2 0.2 0.5</size></box></geometry>
        </visual>
        <collision name="east">
          <pose>3 0 0.25 0 0 0</pose>
          <geometry><box><size>0.2 6.2 0.5</size></box></geometry>
        </collision>
        <visual name="east_v">
          <pose>3 0 0.25 0 0 0</pose>
          <geometry><box><size>0.2 6.2 0.5</size></box></geometry>
        </visual>
        <collision name="west">
          <pose>-3 0 0.25 0 0 0</pose>
          <geometry><box><size>0.2 6.2 0.5</size></box></geometry>
        </collision>
        <visual name="west_v">
          <pose>-3 0 0.25 0 0 0</pose>
          <geometry><box><size>0.2 6.2 0.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="box_obstacle_1">
      <static>true</static>
      <pose>1.5 1.0 0.15 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="box_obstacle_2">
      <static>true</static>
      <pose>-1.2 -1.5 0.15 0 0 -0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.3 0.3</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Fetchable object for the L2 detector: a small red box on the floor,
         0.6 m ahead of the pickup zone pose (1.8, -1.5, yaw 0), so it is in
         view on arrival and `fetch red_box dropoff` works out of the box. -->
    <model name="red_box">
      <static>true</static>
      <pose>2.4 -1.5 0.06 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.8 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
