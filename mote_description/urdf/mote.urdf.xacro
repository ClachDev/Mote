<?xml version="1.0"?>
<robot name="mote" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="cfg" value="${xacro.load_yaml('$(find mote_description)/config/robot.yaml')}"/>

  <!-- Simulation: swaps MoteHardware for gz_ros2_control and adds gz sensors.
       sim_controllers_file is the controller params file gz_ros2_control loads
       (sim_launch.py generates it, injecting wheel geometry from this yaml). -->
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="sim_controllers_file" default=""/>
  <xacro:property name="use_sim" value="$(arg use_sim)"/>

  <!-- SO-101 follower arm links. On by default (the arm is mounted); the sim
       passes arm:=false since it does not model the arm. The joint names match
       mote_description/config/robot.yaml and the /joint_states published by
       mote_arm's driver, so robot_state_publisher animates the arm in TF. -->
  <xacro:arg name="arm" default="true"/>
  <xacro:property name="arm" value="$(arg arm)"/>

  <!-- Wheel-ground friction (Gazebo only). Default 1.0 reproduces gz's own
       default surface friction; lowering it makes the velocity-controlled
       wheels slip, so wheel odometry over-reads while the true pose lags. -->
  <xacro:arg name="wheel_mu" default="1.0"/>
  <xacro:property name="wheel_mu" value="$(arg wheel_mu)"/>


  <!-- ===================== MEASUREMENTS ===================== -->
  <!--
    base_link is at wheel axle height above the ground (REP-105 convention).
    All z positions in base_link frame = (height above ground) - wheel_radius.
  -->

  <!-- Heights above ground -->
  <xacro:property name="base_plate_top_height" value="0.016"/>
  <xacro:property name="lidar_ground_height"   value="0.054"/>
  <xacro:property name="cam_ground_height"     value="0.094"/>

  <!-- Plate geometry -->
  <xacro:property name="chassis_radius"  value="0.115"/>
  <xacro:property name="plate_thickness" value="0.006"/>
  <xacro:property name="plate_gap"       value="0.050"/>
  <xacro:property name="plate_mass"      value="0.01"/>  <!-- dummy -->

  <!-- Drive wheels (STS3215) -->
  <xacro:property name="wheel_radius"     value="${cfg['wheel_radius']}"/>
  <xacro:property name="wheel_width"      value="0.006"/>
  <xacro:property name="wheel_mass"       value="0.05"/>  <!-- dummy -->
  <xacro:property name="wheel_separation" value="${cfg['wheel_separation']}"/>
  <xacro:property name="axle_z"           value="0.0095"/>

  <!-- Caster -->
  <xacro:property name="caster_radius" value="0.016"/>  <!-- assumed -->
  <xacro:property name="caster_mass"   value="0.01"/>   <!-- dummy -->
  <xacro:property name="caster_x"      value="0.100"/>  <!-- assumed -->
  <xacro:property name="caster_z"      value="${caster_radius - (wheel_radius - axle_z)}"/>

  <!-- Lidar -->
  <xacro:property name="lidar_x" value="0.080"/>
  <xacro:property name="lidar_z" value="0.038"/>

  <!-- Camera -->
  <xacro:property name="cam_x" value="0.110"/>
  <xacro:property name="cam_z" value="0.021"/>

  <!-- ===================== DERIVED POSITIONS (base_link frame) ===================== -->

  <xacro:property name="base_plate_z" value="${-axle_z}"/>
  <xacro:property name="top_plate_z"  value="${plate_gap + plate_thickness}"/>

  <!-- ===================== Materials ===================== -->
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.471 0.749 1.0"/></material>

  <!-- ===================== LINKS ===================== -->

  <link name="base_footprint"/>

  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_plate_link">
    <visual>
      <geometry><cylinder radius="${chassis_radius}" length="${plate_thickness}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${chassis_radius}" length="${plate_thickness}"/></geometry>
    </collision>
    <inertial>
      <mass value="${plate_mass}"/>
      <inertia ixx="0.000033" ixy="0" ixz="0"
               iyy="0.000033" iyz="0"
               izz="0.000066"/>
    </inertial>
  </link>

  <joint name="base_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_plate_link"/>
    <origin xyz="0 0 ${base_plate_z}" rpy="0 0 0"/>
  </joint>

  <link name="top_plate_link">
    <visual>
      <geometry><cylinder radius="${chassis_radius}" length="${plate_thickness}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${chassis_radius}" length="${plate_thickness}"/></geometry>
    </collision>
    <inertial>
      <mass value="${plate_mass}"/>
      <inertia ixx="0.000033" ixy="0" ixz="0"
               iyy="0.000033" iyz="0"
               izz="0.000066"/>
    </inertial>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <parent link="base_plate_link"/>
    <child  link="top_plate_link"/>
    <origin xyz="0 0 ${top_plate_z}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="name y_reflect">
    <link name="${name}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000010" ixy="0" ixz="0"
                 iyy="0.000020" iyz="0"
                 izz="0.000010"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left"  y_reflect=" 1"/>
  <xacro:wheel name="right" y_reflect="-1"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <!-- dummy inertia -->
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_plate_link"/>
    <child  link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.038" length="0.04"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_plate_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 ${pi/2}"/>
  </joint>

  <!-- Scan frame can be rotated independently from physical lidar mounting -->
  <link name="lidar_scan_link"/>
  <joint name="lidar_scan_joint" type="fixed">
    <parent link="lidar_link"/>
    <child  link="lidar_scan_link"/>
    <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.025 0.025 0.025"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="top_plate_link"/>
    <child  link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ===================== SO-101 FOLLOWER ARM ===================== -->
  <!--
    Approximate geometry for TF/visualisation only (not dynamics): each link is
    a thin cylinder along its parent-to-child offset. Joint axes follow the
    SO-101 kinematics (pan about Z, lift/elbow/wrist_flex about Y, roll about X).
    Link lengths are nominal; refine if a collision model is ever needed. The
    URDF joint limits are generous — the soft limits that actually gate motion
    live in robot.yaml and are enforced by the mote_arm driver.
  -->
  <xacro:if value="${arm}">
    <material name="arm_grey"><color rgba="0.35 0.35 0.38 1.0"/></material>

    <xacro:macro name="arm_link" params="name length radius:=0.018">
      <link name="${name}">
        <visual>
          <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
          <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
          <material name="arm_grey"/>
        </visual>
      </link>
    </xacro:macro>

    <!-- Arm base: mounted on the top plate, roughly centred. -->
    <link name="arm_base_link">
      <visual>
        <geometry><box size="0.05 0.05 0.03"/></geometry>
        <material name="arm_grey"/>
      </visual>
    </link>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="top_plate_link"/>
      <child  link="arm_base_link"/>
      <origin xyz="0.0 0 0.015" rpy="0 0 0"/>
    </joint>

    <!-- shoulder_pan: yaw about Z -->
    <xacro:arm_link name="shoulder_pan_link" length="0.04"/>
    <joint name="shoulder_pan" type="revolute">
      <parent link="arm_base_link"/>
      <child  link="shoulder_pan_link"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="3.0"/>
    </joint>

    <!-- shoulder_lift: pitch about Y (start of the upper arm) -->
    <xacro:arm_link name="shoulder_lift_link" length="0.116"/>
    <joint name="shoulder_lift" type="revolute">
      <parent link="shoulder_pan_link"/>
      <child  link="shoulder_lift_link"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="3.0"/>
    </joint>

    <!-- elbow_flex: pitch about Y -->
    <xacro:arm_link name="elbow_flex_link" length="0.135"/>
    <joint name="elbow_flex" type="revolute">
      <parent link="shoulder_lift_link"/>
      <child  link="elbow_flex_link"/>
      <origin xyz="0 0 0.116" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="3.0"/>
    </joint>

    <!-- wrist_flex: pitch about Y -->
    <xacro:arm_link name="wrist_flex_link" length="0.05"/>
    <joint name="wrist_flex" type="revolute">
      <parent link="elbow_flex_link"/>
      <child  link="wrist_flex_link"/>
      <origin xyz="0 0 0.135" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="3.0"/>
    </joint>

    <!-- wrist_roll: roll about X -->
    <xacro:arm_link name="wrist_roll_link" length="0.04"/>
    <joint name="wrist_roll" type="revolute">
      <parent link="wrist_flex_link"/>
      <child  link="wrist_roll_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="10" velocity="3.0"/>
    </joint>

    <!-- gripper: one actuated jaw, modelled as a revolute finger -->
    <xacro:arm_link name="gripper_link" length="0.05" radius="0.012"/>
    <joint name="gripper" type="revolute">
      <parent link="wrist_roll_link"/>
      <child  link="gripper_link"/>
      <origin xyz="0.0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.2" upper="1.7" effort="10" velocity="3.0"/>
    </joint>
  </xacro:if>

  <!-- ===================== ROS2 CONTROL ===================== -->

  <ros2_control name="mote_hardware" type="system">
    <xacro:unless value="${use_sim}">
    <hardware>
      <plugin>mote_hardware/MoteHardware</plugin>
      <param name="serial_port">${cfg['servos']['port']}</param>
      <param name="baud_rate">${cfg['servos']['baud_rate']}</param>
      <param name="left_wheel_id">${cfg['servos']['left_id']}</param>
      <param name="right_wheel_id">${cfg['servos']['right_id']}</param>
      <param name="velocity_scale">${cfg['servos']['velocity_scale']}</param>
      <param name="acceleration">${cfg['servos']['acceleration']}</param>
    </hardware>
    </xacro:unless>
    <xacro:if value="${use_sim}">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    </xacro:if>

    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>
  </ros2_control>

  <xacro:if value="${use_sim}">
    <!-- ===================== SIMULATION (Gazebo) ===================== -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg sim_controllers_file)</parameters>
      </plugin>
    </gazebo>

    <!-- Ground-truth pose for the benchmark harness (mote_simulation/tools/
         benchmark): publishes the true model pose in the world frame on
         /model/mote/pose. SceneBroadcaster's /world/*/pose/info loses the frame
         names through the ros_gz bridge; PosePublisher populates them, so the
         benchmark can score localization against a clean ground truth. -->
    <gazebo>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>50</update_frequency>
      </plugin>
    </gazebo>

    <!-- Caster is a fixed sphere: frictionless so it slides instead of dragging -->
    <gazebo reference="caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

    <!-- Drive-wheel friction; wheel_mu defaults to 1.0 (gz default) -->
    <gazebo reference="left_wheel_link">
      <mu1>${wheel_mu}</mu1>
      <mu2>${wheel_mu}</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>${wheel_mu}</mu1>
      <mu2>${wheel_mu}</mu2>
    </gazebo>

    <xacro:property name="lidar_sim" value="${cfg['lidar']['sim']}"/>
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <!-- Rotated to match lidar_scan_link so data agrees with the frame_id -->
        <pose>0 0 0 0 0 ${pi}</pose>
        <topic>scan</topic>
        <gz_frame_id>lidar_scan_link</gz_frame_id>
        <update_rate>${lidar_sim['update_rate']}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${lidar_sim['samples']}</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${lidar_sim['range_min']}</min>
            <max>${lidar_sim['range_max']}</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <xacro:property name="camera_sim" value="${cfg['camera']['sim']}"/>
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <!-- gz_frame_id is the optical frame so the published image/camera_info
             frame_id follows the ROS optical convention (z-forward). The sensor
             body is camera_link (+X-forward), which gz uses as the view axis. -->
        <topic>image_raw</topic>
        <gz_frame_id>camera_optical_link</gz_frame_id>
        <update_rate>${camera_sim['update_rate']}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>${camera_sim['horizontal_fov']}</horizontal_fov>
          <image>
            <width>${camera_sim['width']}</width>
            <height>${camera_sim['height']}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${camera_sim['near']}</near>
            <far>${camera_sim['far']}</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>
